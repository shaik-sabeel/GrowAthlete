# Database – must include /growathlete (not /test or empty). Default "test" DB is not used.
# Prefer MONGODB_URI (Render/Atlas). Fallback MONGOURI is also supported.
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/growathlete
MONGODB_URI=mongodb://localhost:27017/growathlete
MONGOURI=

# JWT Secret (Generate a strong secret for production)
JWT_SECRET=your-super-secret-jwt-key-here

# Google Sign-In (OAuth 2.0). Create credentials at https://console.cloud.google.com/apis/credentials
# Use the same Client ID in the frontend as VITE_GOOGLE_CLIENT_ID
# IMPORTANT: In the OAuth client, add Authorized JavaScript origins (exact match, no trailing slash):
#   - http://localhost:5173   (Vite dev)
#   - http://localhost:3000   (if you use another port)
#   - https://your-production-domain.com
GOOGLE_CLIENT_ID=

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Default Admin (seeded on first successful DB connection if not present)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMeStrong#123

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# API Keys
NEWSDATA_API_KEY=your-newsdata-api-key

# Environment
NODE_ENV=production
PORT=5000

# CORS Origins (comma-separated)
CORS_ORIGINS=https://grow-athlete.vercel.app,https://growathlete-1.onrender.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Optional: GA for Server-side (Express+EJS admin pages)
# Frontend uses its own GA hook; this is only if you render admin via EJS
GA_MEASUREMENT_ID=
